rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Each user can only read/write their own subcollections
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

    // Admin stats: any authenticated user can write (tracking) and read (dashboard)
    match /adminStats/{doc} {
      allow read, write: if request.auth != null;
    }

    // Admin users list: authenticated user writes their own entry; any auth user can read
    match /adminUsers/{userId} {
      allow write: if request.auth != null
                   && request.auth.uid == userId;
      allow read: if request.auth != null;
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
