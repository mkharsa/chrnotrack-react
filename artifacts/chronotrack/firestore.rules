rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Each user can only read/write their own subcollections
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

    // Admin stats: any authenticated user can write (tracking), public read (admin dashboard)
    match /adminStats/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Admin users list: authenticated user writes their own entry, public read (admin dashboard)
    match /adminUsers/{userId} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == userId;
    }

    // Public progression shares: publicly readable, auth required to write
    match /publicShares/{token} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
